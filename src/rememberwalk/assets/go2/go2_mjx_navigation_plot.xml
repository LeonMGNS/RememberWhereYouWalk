<mujoco model="go2">
  <visual>
    <!-- Lower ambient + a little headlight diffuse: vertical wall faces stay
         clearly darker than horizontal floor/wall-top faces, which is what
         makes the walls read as raised. -->
         
    <headlight diffuse="0.35 0.35 0.35" ambient="0.45 0.45 0.45" specular="0.05 0.05 0.05"/>
    <!-- offsamples is the fix for the stair-stepped wall edges: it is the
         multisample count for OFFSCREEN rendering, which is what image dumps
         use. shadowsize sharpens the contact shadows at the wall bases. -->
    <quality offsamples="8" shadowsize="4096"/>
    <map shadowclip="1.0" shadowscale="0.6" znear="0.01"/>
    <!-- Square buffer: the top-down maze view is square, so 1280x720 wastes
         resolution and letterboxes. -->
    <global offwidth="1600" offheight="1600"/>
    <rgba haze="1 1 1 1"/>
  </visual>
  <!-- texturedir added: meshdir covers meshes and heightfields but NOT
       textures, so maze_texture.png would not be found without it. -->
  <compiler angle="radian" meshdir="assets" texturedir="assets" autolimits="true"/>

  <option timestep="0.005" cone="pyramidal" impratio="1" iterations="1" ls_iterations="4">
    <flag eulerdamp="disable" contact="enable" gravity="enable"/>
  </option>

  <default>
    <geom solref="0.02 1" solimp="0.8 0.95 0.001" />
    <default class="go2">
      <geom friction="0.6" margin="0.001" condim="1"/>
      <joint damping="0.05" axis="0 1 0"  armature="0.01" frictionloss="0.2"/>
      <default class="abduction">
        <joint axis="1 0 0" range="-1.0472 1.0472"/>
      </default>
      <default class="hip">
        <default class="front_hip">
          <joint range="-1.5708 3.4907"/>
        </default>
        <default class="back_hip">
          <joint range="-0.5236 4.5379"/>
        </default>
      </default>
      <default class="knee">
        <joint range="-2.7227 -0.83776"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="go2foot">
        <site group="1" pos="-0.002 0 -0.213"/>
        <geom rgba="0.231373 0.380392 0.705882 1"/>
      </default>
      <default class="collision">
        <geom group="3" contype="0" conaffinity="0"/>
        <default class="foot">
          <geom size="0.022" pos="-0.002 0 -0.213" priority="1" solimp="0.8 0.95 0.001" condim="6"
            friction="0.6 0.02 0.01"/>
        </default>
      </default>
    </default>
  </default>

  <custom> 
   <numeric data="20" name="max_contact_points"/> 
   <numeric data="20" name="max_geom_pairs"/> 
 </custom> 
  <asset>
    <!-- Robot: original Go2 colours, restored. -->
    <material name="metal" rgba=".9 .95 .95 1"/>
    <material name="black" rgba="0 0 0 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="gray" rgba="0.671705 0.692426 0.774270 1"/>
    <material name="goal_mat" rgba="0.008 0.62 0.451 1"/>

    <texture name="texplane" type="2d" builtin="flat" rgb1=".8 .8 .8" width="100" height="100"/>

    <!-- The maze is one hfield geom and a geom carries one material, so walls
         cannot be coloured separately by any XML edit. The colour comes from a
         2D texture mapped across the hfield's XY extent, generated from the
         same array as the heightfield by make_maze_assets.py.
         The old checker was the real readability problem: texrepeat="1 1" over
         a 10x10 m field gives 5 m squares, i.e. the four big quadrants that
         washed across the maze. -->
    <!-- No file: builtin just allocates a buffer of this size, which
         maze_visual_runtime.apply_maze() fills in memory from the same array
         it writes into hfield_data. Make width/height an integer multiple of
         your maze grid (here 8 x 100) for crisp cell edges. -->
    <!-- rgb1 is deliberately magenta, NOT the floor grey: if you see magenta in
         a render, the painter never ran (flag off, or MazePainter construction
         failed). Grey means it ran and produced an empty wall mask. Making the
         two look identical hides which of the two happened. -->
    <texture name="maze_tex" type="2d" builtin="flat" rgb1="1 0 1"
             width="100" height="100"/>
    <material name="maze_mat" texture="maze_tex" texrepeat="1 1" texuniform="false"
              specular="0.05" shininess="0.05" reflectance="0"/>

    <!-- Fallback if you would rather not generate a texture: flat light floor,
         walls readable purely from shading and cast shadows.
         Swap the floor geom to material="maze_flat". -->
    <material name="maze_flat" rgba="0.333 0.333 0.333 1" specular="0.05" shininess="0.05" reflectance="0"/>

    <material name="MatPlane" reflectance="0.5" texture="texplane" texrepeat="1 1" texuniform="true"></material>
    <mesh file="base_0.obj"/>
    <mesh file="base_1.obj"/>
    <mesh file="base_2.obj"/>
    <mesh file="base_3.obj"/>
    <mesh file="base_4.obj"/>
    <mesh file="hip_0.obj"/>
    <mesh file="hip_1.obj"/>
    <mesh file="thigh_0.obj"/>
    <mesh file="thigh_1.obj"/>
    <mesh file="thigh_mirror_0.obj"/>
    <mesh file="thigh_mirror_1.obj"/>
    <mesh file="calf_0.obj"/>
    <mesh file="calf_1.obj"/>
    <mesh file="calf_mirror_0.obj"/>
    <mesh file="calf_mirror_1.obj"/>
    <mesh file="foot.obj"/>
    <!-- UNCHANGED. The elevation scale (30) multiplies the normalised PNG, so
         the real wall height depends on the values you write into it. Editing
         this would rescale every wall, so it is left exactly as it was. -->
    <hfield name="empty_hfield" file="default_hfield_100x100.png" size="5 5 30 2"/>
  </asset>

  <worldbody>
